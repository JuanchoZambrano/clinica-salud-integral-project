generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id       Int    @id @default(autoincrement())
  roleName String @unique @db.VarChar(30)

  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  userName     String   @unique @db.VarChar(100)
  userEmail    String   @unique @db.VarChar(120)
  userPassword String   @db.VarChar(255)
  status       Boolean  @default(true)
  roleId       Int
  createdAt    DateTime @default(now())

  role  Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  medic Medic?

  @@index([roleId])
  @@map("users")
}

model Patient {
  id              Int      @id @default(autoincrement())
  patientName     String   @db.VarChar(100)
  patientLastName String   @db.VarChar(100)
  personalId      String   @unique @db.VarChar(30)
  birthDate       DateTime @db.Date
  patientEmail    String   @unique @db.VarChar(120)
  patientPhone    String?  @db.VarChar(20)
  patientAddress  String?  @db.VarChar(200)
  createdAt       DateTime @default(now())

  appointments Appointment[]

  @@map("patients")
}

model Specialty {
  id            Int     @id @default(autoincrement())
  specialtyName String  @unique @db.VarChar(100)
  description   String? @db.Text

  medics Medic[]

  @@map("specialties")
}

model Medic {
  id               Int     @id @default(autoincrement())
  professionalCode String  @unique @db.VarChar(50)
  medicPhone       String? @db.VarChar(20)
  userId           Int     @unique
  specialtyId      Int

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  @@index([specialtyId])
  @@map("medics")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id              Int               @id @default(autoincrement())
  appointmentDate DateTime          @db.Timestamp(3)
  observation     String?           @db.Text
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  patientId       Int
  medicId         Int

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  medic Medic @relation(fields: [medicId], references: [id], onDelete: Restrict)

  @@index([medicId, appointmentDate])
  @@index([patientId, appointmentDate])
  @@index([appointmentDate, status])
  @@map("appointments")
}
